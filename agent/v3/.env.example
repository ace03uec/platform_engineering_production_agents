# Copy to agent/.env (one level up, shared by all agent versions).
# v0 needs a working provider key only for diagnoses; monitoring and health
# endpoints work without one.

# opencode-go (free models):
PI_PROVIDER=opencode-go
PI_MODEL=qwen3.8-flash
OPENCODE_API_KEY=

# Anthropic:
# PI_PROVIDER=anthropic
# PI_MODEL=claude-sonnet-4-5
# ANTHROPIC_API_KEY=

# OpenRouter:
# PI_PROVIDER=openrouter
# PI_MODEL=nvidia/nemotron-3.5-lightning:free
# OPENROUTER_API_KEY=

# v3 cost controls:
# AGENT_BUDGET_USD=0.05     # cumulative spend cap; breaker blocks model calls above it
# ASSESS_EVERY_POLL=true    # per-poll model assessment (the anti-pattern under study)
# POLL_INTERVAL_MS=10000
