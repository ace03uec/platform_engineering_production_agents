{
  "uid": "workshop-agent-evals-v6",
  "title": "Agent Evaluations \u2014 v6",
  "description": "Offline fixed-case evaluations. Live is real provider output; fixture is a scripted harness smoke test, NOT model performance. Latest complete paired run scores are held until the next run; inspect last-run timestamp and completion. Compare matching suite/prompt/grader/harness only.",
  "schemaVersion": 41,
  "version": 1,
  "editable": false,
  "tags": [
    "workshop",
    "cost",
    "agent"
  ],
  "timezone": "browser",
  "refresh": "5s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Pass rate by model",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "workshop-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "agent_eval_pass_rate{mode=\"$mode\"}",
          "legendFormat": "{{model}} / {{suite}} / {{prompt}}",
          "instant": false,
          "range": true,
          "datasource": {
            "type": "prometheus",
            "uid": "workshop-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 15,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "description": "Latest-run values held between evaluations. Missing data means UNKNOWN; fixture mode is not a model benchmark."
    },
    {
      "id": 2,
      "title": "Mean rubric score",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
