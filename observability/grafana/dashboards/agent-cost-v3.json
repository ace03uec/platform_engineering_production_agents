{
  "uid": "workshop-agent-cost-v3",
  "title": "Agent Cost \u2014 v3",
  "description": "v3 adds the stop lever to v2's runaway: a budget circuit breaker (AGENT_BUDGET_USD), a manual kill switch (POST /cost/stop, /cost/resume, /cost/budget), and storm fixes (one diagnosis per incident, one call in flight). Blocked calls are counted by reason. Counters reset on agent restart.",
  "schemaVersion": 41,
  "version": 1,
  "editable": false,
  "tags": [
    "workshop",
    "cost",
    "agent"
  ],
  "timezone": "browser",
  "refresh": "5s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Total spend",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "workshop-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 4,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "expr": "agent_llm_cost_usd_total{version=\"v3\"}",
          "instant": true,
          "range": false,
          "datasource": {
            "type": "prometheus",
            "uid": "workshop-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "noValue": "UNKNOWN",
          "decimals": 4,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.03
              },
              {
                "color": "red",
                "value": 0.05
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 2,
      "title": "Budget",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "workshop-prometheus"
      },
      "gridPos": {
        "x": 4,
        "y": 0,
        "w": 4,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "expr": "agent_cost_budget_usd{version=\"v3\"}",
          "instant": true,
          "range": false,
          "datasource": {
            "type": "prometheus",
            "uid": "workshop-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "noValue": "UNKNOWN",
          "decimals": 4,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "description": "AGENT_BUDGET_USD, adjustable live via POST /cost/budget?usd=..."
    },
    {
      "id": 3,
      "title": "Remaining",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "workshop-prometheus"
      },
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 4,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "expr": "agent_cost_budget_usd{version=\"v3\"} - agent_llm_cost_usd_total{version=\"v3\"}",
          "instant": true,
          "range": false,
          "datasource": {
            "type": "prometheus",
            "uid": "workshop-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "noValue": "UNKNOWN",
          "decimals": 4,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.005
              },
              {
                "color": "green",
                "value": 0.02
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 4,
      "title": "Budget breaker",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "workshop-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 4,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "expr": "agent_cost_breaker_open{version=\"v3\"}",
          "legendFormat": "breaker",
          "instant": true,
          "range": false,
          "datasource": {
            "type": "prometheus",
            "uid": "workshop-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "UNKNOWN",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "CLOSED",
                  "color": "green"
                },
                "1": {
                  "text": "OPEN \u2014 BLOCKING",
                  "color": "red"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "description": "OPEN means cumulative spend reached the budget and all model calls are refused."
    },
    {
      "id": 5,
      "title": "Kill switch",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "workshop-prometheus"
      },
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 4,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "expr": "agent_cost_manual_stop{version=\"v3\"}",
          "legendFormat": "manual stop",
          "instant": true,
          "range": false,
          "datasource": {
            "type": "prometheus",
            "uid": "workshop-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "UNKNOWN",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "OFF",
                  "color": "green"
                },
                "1": {
                  "text": "STOPPED",
                  "color": "red"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "description": "Operator lever: POST /cost/stop to pull it, POST /cost/resume to release."
    },
    {
      "id": 6,
      "title": "Blocked calls",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "workshop-prometheus"
      },
      "gridPos": {
        "x": 20,
        "y": 0,
        "w": 4,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(agent_model_calls_blocked_total{version=\"v3\"})",
          "instant": true,
          "range": false,
          "datasource": {
            "type": "prometheus",
            "uid": "workshop-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "UNKNOWN",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "description": "Model calls refused by the gate. Nonzero means the lever is actively saving money."
    },
    {
      "id": 7,
      "title": "Cumulative spend vs budget",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "workshop-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "expr": "agent_llm_cost_usd_total{version=\"v3\"}",
          "legendFormat": "spend",
          "instant": false,
          "range": true,
          "datasource": {
            "type": "prometheus",
            "uid": "workshop-prometheus"
          }
        },
        {
          "refId": "B",
          "expr": "agent_cost_budget_usd{version=\"v3\"}",
          "legendFormat": "budget",
          "instant": false,
          "range": true,
          "datasource": {
            "type": "prometheus",
            "uid": "workshop-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 15,
            "spanNulls": false
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "budget"
            },
            "properties": [
              {
                "id": "custom.lineStyle",
                "value": {
                  "fill": "dash",
                  "dash": [
                    8,
                    8
                  ]
                }
              },
              {
                "id": "custom.fillOpacity",
                "value": 0
              },
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "description": "The v2 hockey stick now flattens when spend meets the budget."
    },
    {
      "id": 8,
      "title": "Spend rate ($/min)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "workshop-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 5,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(agent_llm_cost_usd_total{version=\"v3\"}[1m]) * 60",
          "legendFormat": "$/min",
          "instant": false,
          "range": true,
          "datasource": {
            "type": "prometheus",
            "uid": "workshop-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 15,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "description": "Drops to zero when the breaker opens or the kill switch is pulled \u2014 proof the lever works."
    },
    {
      "id": 9,
      "title": "Model calls by purpose",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "workshop-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (purpose) (increase(agent_model_calls_total{version=\"v3\"}[$__rate_interval]))",
          "legendFormat": "{{purpose}}",
          "instant": false,
          "range": true,
          "datasource": {
            "type": "prometheus",
            "uid": "workshop-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 60,
            "stacking": {
              "mode": "normal"
            },
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 10,
      "title": "Blocked calls by reason",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "workshop-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 14,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (purpose, reason) (increase(agent_model_calls_blocked_total{version=\"v3\"}[$__rate_interval]))",
          "legendFormat": "{{purpose}} \u2014 {{reason}}",
          "instant": false,
          "range": true,
          "datasource": {
            "type": "prometheus",
            "uid": "workshop-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 60,
            "stacking": {
              "mode": "normal"
            },
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "description": "budget = breaker open, stopped = kill switch pulled, concurrency = single-flight slot busy."
    }
  ],
